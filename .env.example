# ==============================================================================
# Intent Security Workbench — Environment Variable Specification & Template
# ==============================================================================
# Security Invariant: NEVER commit active credentials, production secrets, or
# private tokens to version control. This template uses generic placeholders only.
# ==============================================================================

# ==============================================================================
# 1. REQUIRED FOR PRODUCTION / CORE RUNTIME
# ==============================================================================

# API Server listen port (Integer: 1-65535)
# [REQUIRED: NO, DEFAULT: 3000] [CONTAINS CREDENTIALS: NO] [SAFE FOR FRONTEND: YES]
API_PORT=3000

# API Server network interface bind address (IP or hostname)
# [REQUIRED: NO, DEFAULT: 0.0.0.0] [CONTAINS CREDENTIALS: NO] [SAFE FOR FRONTEND: NO]
API_HOST=0.0.0.0

# Deployment execution tier: development | production | test
# [REQUIRED: NO, DEFAULT: development] [CONTAINS CREDENTIALS: NO] [SAFE FOR FRONTEND: YES]
ENVIRONMENT=development

# Node runtime execution environment: development | production | test
# [REQUIRED: NO, DEFAULT: development] [CONTAINS CREDENTIALS: NO] [SAFE FOR FRONTEND: YES]
NODE_ENV=development

# Security Invariant: MUST be false to prevent unrestricted shell command execution
# [REQUIRED: YES, DEFAULT: false] [CONTAINS CREDENTIALS: NO] [SAFE FOR FRONTEND: NO]
SANDBOX_ALLOW_ARBITRARY_SHELL=false

# Security Invariant: Enforce explicit target scope authorization before scans
# [REQUIRED: YES, DEFAULT: true] [CONTAINS CREDENTIALS: NO] [SAFE FOR FRONTEND: NO]
SANDBOX_STRICT_SCOPE_CHECK=true

# Execution timeout for sandboxed verification engines in milliseconds (>= 1000)
# [REQUIRED: NO, DEFAULT: 120000] [CONTAINS CREDENTIALS: NO] [SAFE FOR FRONTEND: NO]
SANDBOX_TIMEOUT_MS=120000

# Minimum logging severity: DEBUG | INFO | WARN | ERROR
# [REQUIRED: NO, DEFAULT: INFO] [CONTAINS CREDENTIALS: NO] [SAFE FOR FRONTEND: NO]
LOG_LEVEL=INFO


# ==============================================================================
# 2. OPTIONAL SERVICES (DATABASE & DISTRIBUTED QUEUE)
# ==============================================================================
# Note: If unset, the Workbench automatically boots with high-fidelity in-memory
# persistence and in-process job queuing. No crash occurs when omitted.

# PostgreSQL Connection String
# [REQUIRED: OPTIONAL] [CONTAINS CREDENTIALS: YES - REDACTED IN ALL LOGS & DIAGNOSTICS]
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# Example placeholder:
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# Redis Connection String for distributed worker queue (Celery/BullMQ)
# [REQUIRED: OPTIONAL] [CONTAINS CREDENTIALS: YES - REDACTED IN ALL LOGS & DIAGNOSTICS]
# Format: redis://HOST:PORT/DB or redis://:PASSWORD@HOST:PORT/DB
# Example placeholder:
# REDIS_URL=redis://HOST:6379/0


# ==============================================================================
# 3. AI PROVIDERS & SECURITY CONTROLLER
# ==============================================================================
# Note: In-depth reasoning and AST verification can be driven by a selected AI provider.
# If AI_PROVIDER=none or unset, the workbench operates cleanly in pure deterministic mode.

# AI Provider Selection: none | gemini | grok | openai | anthropic | custom
# [REQUIRED: NO, DEFAULT: none] [CONTAINS CREDENTIALS: NO] [SAFE FOR FRONTEND: YES]
AI_PROVIDER=none

# AI Model Identifier (e.g. gemini-3.8-flash, grok-beta, gpt-4o, claude-3-5-sonnet-latest)
# [REQUIRED: NO, DEFAULT: gemini-3.8-flash] [CONTAINS CREDENTIALS: NO] [SAFE FOR FRONTEND: YES]
AI_MODEL=gemini-3.8-flash

# Custom AI Proxy or local endpoint URL (optional, e.g. for local Ollama/vLLM)
# [REQUIRED: NO] [CONTAINS CREDENTIALS: NO] [SAFE FOR FRONTEND: NO]
# AI_ENDPOINT=http://localhost:11434/v1

# Sampling temperature for deterministic security reasoning (0.0 - 1.0)
# [REQUIRED: NO, DEFAULT: 0.1] [CONTAINS CREDENTIALS: NO] [SAFE FOR FRONTEND: NO]
AI_TEMPERATURE=0.1

# Maximum response tokens limit for AI analysis output
# [REQUIRED: NO, DEFAULT: 4096] [CONTAINS CREDENTIALS: NO] [SAFE FOR FRONTEND: NO]
AI_MAX_TOKENS=4096

# --- Provider Credentials (Server-Side Secrets ONLY) ---
# Strict Rule: NEVER expose these to the browser, VITE_* variables, or prompt contexts.

# Google Gemini API key (Required if AI_PROVIDER=gemini)
# [REQUIRED: OPTIONAL] [CONTAINS CREDENTIALS: YES] [SAFE FOR FRONTEND: NO]
# GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# xAI Grok API key (Required if AI_PROVIDER=grok)
# [REQUIRED: OPTIONAL] [CONTAINS CREDENTIALS: YES] [SAFE FOR FRONTEND: NO]
# GROK_API_KEY=YOUR_GROK_API_KEY_HERE

# OpenAI API key (Required if AI_PROVIDER=openai)
# [REQUIRED: OPTIONAL] [CONTAINS CREDENTIALS: YES] [SAFE FOR FRONTEND: NO]
# OPENAI_API_KEY=YOUR_OPENAI_API_KEY_HERE

# Anthropic Claude API key (Required if AI_PROVIDER=anthropic)
# [REQUIRED: OPTIONAL] [CONTAINS CREDENTIALS: YES] [SAFE FOR FRONTEND: NO]
# ANTHROPIC_API_KEY=YOUR_ANTHROPIC_API_KEY_HERE


# ==============================================================================
# 4. PUBLIC FRONTEND & CLIENT CONFIGURATION
# ==============================================================================
# Variables prefixed with VITE_ are bundled into browser-accessible assets.
# NEVER store secrets, private tokens, or database passwords in VITE_* variables.

# Public API URL for frontend queries (empty string defaults to relative /api)
# [REQUIRED: NO, DEFAULT: ""] [CONTAINS CREDENTIALS: NO] [SAFE FOR FRONTEND: YES]
VITE_API_URL=

# Public WebSocket URL for real-time live events (empty string derives from window.location)
# [REQUIRED: NO, DEFAULT: ""] [CONTAINS CREDENTIALS: NO] [SAFE FOR FRONTEND: YES]
VITE_WS_URL=


# ==============================================================================
# 5. CLI & LOCAL TESTING
# ==============================================================================

# API Base URL queried by the CLI tool (cli.ts)
# [REQUIRED: NO, DEFAULT: http://127.0.0.1:3000] [CONTAINS CREDENTIALS: NO] [SAFE FOR FRONTEND: YES]
API_URL=http://127.0.0.1:3000
